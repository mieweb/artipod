# ArtiPod MCP Server Configuration

# Directory where pod workspaces will be stored
WORKSPACE_DIR=/path/to/workspace

# Optional: Specific pod ID (will be auto-generated if not provided)
# POD_ID=my-custom-pod-id

# Path to Dockerfile for container execution
DOCKERFILE_PATH=../../container/Dockerfile

# Path to seccomp security profile
SECCOMP_PROFILE_PATH=../../container/seccomp-profiles/sandbox.json

# Container resource limits (optional)
# CONTAINER_MEMORY_MB=512
# CONTAINER_CPU_COUNT=1

# Default command timeout in milliseconds (optional, default: 30000)
# COMMAND_TIMEOUT_MS=30000
