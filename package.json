{
  "name": "artipod",
  "version": "0.1.0",
  "description": "TypeScript module for managing AI-aware file storage with ArtiPods and ArtiMounts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "dev": "cd examples/web-demo/backend && npm run dev",
    "dev:frontend": "cd examples/web-demo/frontend && npm run dev"
  },
  "keywords": [
    "ai",
    "storage",
    "metadata",
    "typescript",
    "file-management"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/dockerode": "^3.3.47",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dockerode": "^4.0.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
