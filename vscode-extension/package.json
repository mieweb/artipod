{
  "name": "artipod",
  "displayName": "Artipod",
  "description": "An Artipod terminal, workspace snapshots, and isolated forks in VS Code.",
  "version": "0.1.0",
  "publisher": "mieweb",
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:_artipod.checkpoints.capture",
    "onCommand:_artipod.checkpoints.restore",
    "onCommand:_artipod.checkpoints.fork",
    "onFileSystem:artipod"
  ],
  "contributes": {
    "configuration": {
      "title": "Artipod",
      "properties": {
        "artipod.checkpoints.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "Experimental native Chat checkpoint integration for a patched VS Code or Ozwell Desktop build. Leave disabled in stock VS Code. Artipod terminal, manual snapshots, forks and mirror commands work without this setting or core patches."
        }
      }
    },
    "commands": [
      {
        "command": "artipod.openPodTerminal",
        "title": "Artipod: Open Pod Terminal"
      },
      {
        "command": "artipod.createSnapshot",
        "title": "Artipod: Create Workspace Snapshot"
      },
      {
        "command": "artipod.openSnapshot",
        "title": "Artipod: Open Snapshot in New Workspace"
      },
      {
        "command": "artipod.openMirror",
        "title": "Artipod: Open Active File in Workspace Mirror"
      }
    ]
  },
  "scripts": {
    "test": "npm run prepare-backend && node --test test/*.test.js",
    "prepare-backend": "node scripts/prepare-backend.js",
    "vscode:prepublish": "npm --prefix .. run build && npm run prepare-backend",
    "package:vsix": "node scripts/package-vsix.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@vscode/vsce": "4.0.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "preview": true,
  "categories": [
    "Other"
  ],
  "keywords": [
    "artipod",
    "snapshot",
    "workspace",
    "terminal",
    "filesystem"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mieweb/artipod.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://github.com/mieweb/artipod/tree/artipod/vscode-extension",
  "bugs": {
    "url": "https://github.com/mieweb/artipod/issues"
  },
  "author": "Medical Informatics Engineering, LLC"
}
